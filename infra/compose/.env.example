# Copy to .env next to compose.yaml and change what you need. Everything has a default.

# The image tag: a release such as 1.2.3, or latest.
PRIKBOARD_VERSION=latest

# The localhost port the app is published on.
PRIKBOARD_PORT=8080

# The database password. The database is only reachable from the app, but set your own anyway, before the first start:
# PostgreSQL keeps the password it was created with.
POSTGRES_PASSWORD=prikboard

# Your domain, for HTTPS through Caddy (docker compose --profile https up -d), e.g. board.example.com.
DOMAIN=
