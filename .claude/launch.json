{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "api",
      "runtimeExecutable": "dotnet",
      "runtimeArgs": ["run", "--project", "src/PrikBoard.Api", "--launch-profile", "http"],
      "port": 5080
    },
    {
      "name": "api-tunnel",
      "runtimeExecutable": "powershell",
      "runtimeArgs": ["-NoProfile", "-Command", "$env:ASPNETCORE_FORWARDEDHEADERS_ENABLED = 'true'; dotnet run --project src/PrikBoard.Api --launch-profile http"],
      "port": 5080
    },
    {
      "name": "api-fake-slack",
      "runtimeExecutable": "dotnet",
      "runtimeArgs": ["run", "--project", "src/PrikBoard.Api", "--launch-profile", "http", "--", "--Slack:ApiUrl=http://localhost:5090/api/"],
      "port": 5080
    },
    {
      "name": "fake-slack",
      "runtimeExecutable": "dotnet",
      "runtimeArgs": ["run", "--project", "tools/FakeSlack"],
      "port": 5090
    },
    {
      "name": "web",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev", "--prefix", "src/web"],
      "port": 5173
    },
    {
      "name": "web-tunnel",
      "runtimeExecutable": "powershell",
      "runtimeArgs": ["-NoProfile", "-Command", "$env:__VITE_ADDITIONAL_SERVER_ALLOWED_HOSTS = '.trycloudflare.com'; npm run dev --prefix src/web"],
      "port": 5173
    },
    {
      "name": "web-docker",
      "runtimeExecutable": "bash",
      "runtimeArgs": ["-c", "docker run --rm --init --network host -u \"$(id -u):$(id -g)\" -e npm_config_cache=/tmp/.npm -v \"$PWD/src/web\":/app -w /app node:22 npm run dev"],
      "port": 5173
    },
    {
      "name": "perf-api",
      "runtimeExecutable": "node",
      "runtimeArgs": ["tools/perf/serve-board.mjs", "--snapshot=tools/perf/out/board.json", "--clip=tools/perf/out/perf-board.json", "--port=5099"],
      "port": 5099
    },
    {
      "name": "perf-web",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "preview", "--prefix", "src/web", "--", "--port", "5188", "--strictPort"],
      "env": { "PRIKBOARD_API_URL": "http://localhost:5099" },
      "port": 5188
    }
  ]
}
