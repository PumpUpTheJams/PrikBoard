# Keep an X-Forwarded-Proto set by a TLS-terminating proxy in front of this container; otherwise use our own scheme.
map $http_x_forwarded_proto $forwarded_proto {
    default $http_x_forwarded_proto;
    ''      $scheme;
}

# Likewise keep the original host when the proxy in front rewrites Host and sends it as X-Forwarded-Host.
map $http_x_forwarded_host $forwarded_host {
    default $http_x_forwarded_host;
    ''      $http_host;
}

# WebSocket upgrades for the live-updates hub; plain requests keep a normal Connection header.
map $http_upgrade $connection_upgrade {
    default upgrade;
    ''      close;
}

server {
    listen 8080;
    server_name _;
    root /usr/share/nginx/html;

    # Like the Vite dev proxy (changeOrigin: false), pass the browser's host through: the API builds OAuth
    # callback URLs and the OpenAPI server URL from it.
    location ~ ^/(api|openapi|scalar)(/|$) {
        proxy_pass ${API_URL};
        # Image uploads are up to 10 MB (ImageFormats.MaxBytes); nginx's default is 1 MB.
        client_max_body_size 11m;
        proxy_set_header Host $forwarded_host;
        proxy_set_header X-Forwarded-Proto $forwarded_proto;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    }

    # The live-updates hub (SignalR) holds WebSockets open; ^~ wins over the regex location above.
    location ^~ /api/live {
        proxy_pass ${API_URL};
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        # The hub compares the Origin of cookie connections with this host.
        proxy_set_header Host $forwarded_host;
        proxy_set_header X-Forwarded-Proto $forwarded_proto;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        # SignalR pings every 15 s; anything quieter than this is a dead connection.
        proxy_read_timeout 60s;
    }

    # MCP (Streamable HTTP) may answer with a server-sent event stream; don't buffer it.
    location = /mcp {
        proxy_pass ${API_URL};
        proxy_http_version 1.1;
        proxy_buffering off;
        proxy_set_header Host $forwarded_host;
        proxy_set_header X-Forwarded-Proto $forwarded_proto;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    }

    # Vite puts content-hashed files in /assets, so they can be cached forever.
    location /assets/ {
        add_header Cache-Control "public, max-age=31536000, immutable";
    }

    location / {
        try_files $uri $uri/ /index.html;
        add_header Cache-Control "no-cache";
        # No other site may frame the app, so it cannot trick people into clicking (for example "Allow" on #/connect).
        add_header X-Frame-Options "DENY" always;
        add_header Content-Security-Policy "frame-ancestors 'none'" always;
    }
}
