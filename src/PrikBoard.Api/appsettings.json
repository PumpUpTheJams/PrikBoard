{
  "ConnectionStrings": {
    "PrikBoard": "Host=127.0.0.1;Port=5432;Database=prikboard;Username=prikboard;Password=prikboard"
  },
  "Serilog": {
    "Using": ["Serilog.Sinks.Console"],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.Hosting.Lifetime": "Information",
        "Microsoft.EntityFrameworkCore": "Warning",
        "Microsoft.EntityFrameworkCore.Migrations": "Information",
        "System.Net.Http.HttpClient": "Warning",
        "ModelContextProtocol": "Warning",
        "Npgsql": "Warning",
        "AspNet.Security.OpenId": "Warning",
        "Serilog.AspNetCore.RequestLoggingMiddleware": "Information"
      }
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": { "outputTemplate": "[{Timestamp:HH:mm:ss} {Level:u3}] {SourceContext}: {Message:lj}{NewLine}{Exception}" }
      }
    ]
  },
  "OpenTelemetry": {
    "Endpoint": "",
    "Protocol": "grpc",
    "Headers": ""
  },
  "AllowedHosts": "*",
  "Storage": {
    "MemoryCacheBytes": 67108864,
    "MemoryCacheMaxFileBytes": 1048576
  },
  "Auth": {
    "DefaultProvider": "github",
    "Providers": {
      "github": {
        "Type": "GitHub",
        "DisplayName": "GitHub",
        "ClientId": ""
      },
      "google": {
        "DisplayName": "Google",
        "Authority": "https://accounts.google.com",
        "ClientId": ""
      }
    },
    "Tokens": {
      "Audience": "api://prikboard",
      "Issuers": {}
    }
  }
}
