src/PrikBoard.Api/appsettings.Production.json
src/PrikBoard.Api/appsettings.*.local.json
src/PrikBoard.Api/*.user
src/PrikBoard.Api/prikboard.db*
src/web/node_modules/
src/web/dist/
src/web/*.local
src/web/.env*
