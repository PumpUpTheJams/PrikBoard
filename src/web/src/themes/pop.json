{
  "$schema": "./theme.schema.json",
  "format": 1,
  "id": "pop",
  "name": "Pop",
  "description": "Comic book: white paper, a yellow bar, ink outlines and bright cards.",
  "colorScheme": "light",
  "extends": "positivity",
  "fonts": [
    "Bricolage Grotesque:opsz,wght@12..96,400;12..96,500;12..96,600;12..96,700"
  ],
  "tokens": {
    "bg": "#fffdf6",
    "bar": "#ffcf33",
    "bar-line": "#111111",
    "panel": "#ffffff",
    "panel-2": "#faf7ee",
    "dialog": "#ffffff",
    "dialog-line": "#111111",
    "line": "#1f1f1f",
    "line-strong": "#111111",
    "text": "#111111",
    "text-2": "#222222",
    "text-body": "#222222",
    "muted": "#3d3d3d",
    "subtle": "#555555",
    "hover": "#fff1b8",
    "tool-hover": "#ffe98a",
    "row-hover": "#fff6d1",
    "accent": "#2d5bff",
    "accent-ink": "#ffffff",
    "accent-bg": "#dbe4ff",
    "danger": "#c62828",
    "danger-strong": "#e0392b",
    "bucket-bg": "rgba(255, 255, 255, 0.85)",
    "bucket-fill": "rgba(255, 255, 255, 0.97)",
    "bucket-dot": "rgba(17, 17, 17, 0.07)",
    "dot": "rgba(17, 17, 17, 0.16)",
    "mini-bg": "#fffaf0",
    "mini-dot": "rgba(17, 17, 17, 0.1)",
    "chip": "#f0ece0",
    "dim": "rgba(255, 253, 246, 0.8)",
    "minimap-bucket-fill": "#e8e8e8",
    "slot": "#9a9a9a",
    "halo": "#ff4fa3",
    "float-shadow": "3px 3px 0 #111111",
    "scrollbar-thumb": "#c9c4b5",
    "scrollbar-thumb-hover": "#9a958a",
    "scrollbar-track": "#f4f0e4",
    "window-shadow": "8px 8px 0 #111111",
    "dialog-shadow": "6px 6px 0 #111111",
    "avatar-bg": "#111111",
    "avatar-text": "#ffffff",
    "avatar-more-bg": "#333333",
    "avatar-more-text": "#ffffff",
    "agent-bg": "#ffd6ec",
    "agent-text": "#b0006a",
    "discord-bg": "#dfe2ff",
    "discord-text": "#2e33a8",
    "ink": "#111111",
    "fill-butter": "#ffd84d",
    "fill-mint": "#63e6a7",
    "fill-sky": "#6fb7ff",
    "fill-coral": "#ff6b57",
    "fill-lilac": "#c49bff",
    "tone-butter": "#b88a00",
    "tone-mint": "#0a8a55",
    "tone-sky": "#1f63c9",
    "tone-coral": "#d63a26",
    "tone-lilac": "#7a3fd0",
    "ghost-bg": "#ffffff",
    "font": "'Bricolage Grotesque', ui-sans-serif, system-ui, sans-serif"
  },
  "bar": {
    "colorScheme": "light",
    "tokens": {
      "text": "#111111",
      "text-2": "#222222",
      "text-body": "#111111",
      "muted": "#3a3a3a",
      "subtle": "#4a4a4a",
      "hover": "rgba(17, 17, 17, 0.08)",
      "tool-hover": "rgba(17, 17, 17, 0.12)",
      "line": "#111111",
      "line-strong": "#111111",
      "panel": "#ffe170",
      "chip": "rgba(17, 17, 17, 0.12)",
      "accent": "#111111",
      "accent-ink": "#ffcf33",
      "accent-bg": "rgba(17, 17, 17, 0.14)",
      "avatar-more-bg": "#333333",
      "ghost-bg": "transparent"
    }
  }
}
