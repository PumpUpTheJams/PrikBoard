@host = http://localhost:5080

### OpenAPI document (the machine-readable contract for AI agents)
GET {{host}}/openapi/v1.json

### List boards
GET {{host}}/api/boards

### Create a board
# @name createBoard
POST {{host}}/api/boards
Content-Type: application/json

{
  "name": "Website relaunch",
  "description": "Everything needed to ship the new site"
}

###
@boardId = {{createBoard.response.body.$.id}}
@doneBucketId = {{createBoard.response.body.$.buckets[2].id}}

### Full board snapshot
GET {{host}}/api/boards/{{boardId}}

### Stick a note on the board (lands in a free spot in the first bucket)
# @name createNote
POST {{host}}/api/boards/{{boardId}}/notes
Content-Type: application/json

{
  "title": "Pick a colour palette",
  "body": "Three options for the team to vote on",
  "color": "Coral",
  "tags": ["design"],
  "assignees": [{ "name": "Mila V." }],
  "checklist": [{ "text": "Three options" }, { "text": "Team vote" }]
}

###
@noteId = {{createNote.response.body.$.id}}

### An agent picks the note up: assign it and show the "agent working" halo
PATCH {{host}}/api/notes/{{noteId}}
Content-Type: application/json

{
  "assignees": [{ "name": "Mila V." }, { "name": "Claude", "kind": "Agent" }],
  "agentWorking": true
}

### Move the note into Done (the server picks a free spot)
POST {{host}}/api/notes/{{noteId}}/move
Content-Type: application/json

{
  "bucketId": "{{doneBucketId}}"
}

### Move the note to exact coordinates (its bucket follows from where it lands)
POST {{host}}/api/notes/{{noteId}}/move
Content-Type: application/json

{
  "x": 1400,
  "y": 80
}

### Draw a bucket
POST {{host}}/api/boards/{{boardId}}/buckets
Content-Type: application/json

{
  "name": "Review",
  "color": "Violet",
  "x": 40,
  "y": 680,
  "width": 880,
  "height": 300
}

### Search notes
GET {{host}}/api/boards/{{boardId}}/notes?search=palette
